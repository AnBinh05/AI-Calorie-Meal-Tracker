# ==============================================================================
# 🔐 NUTRIAI BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# ⚠️ CẢNH BÁO BẢO MẬT:
# 1. KHÔNG BAO GIỜ commit file `.env` lên GitHub hoặc bất kỳ kho mã nguồn nào.
# 2. KHÔNG BAO GIỜ paste API key, secret token thật vào file mẫu `.env.example`.
# 3. Để sử dụng: Tạo bản sao tệp này thành `.env` và điền thông tin thực tế:
#    cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 🗄️ Database (PostgreSQL)
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/calorie_tracker_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgresql_password_here

# ------------------------------------------------------------------------------
# 🔑 JWT Security
# Tạo chuỗi Base64 256-bit an toàn ngẫu nhiên bằng lệnh:
#   openssl rand -base64 32
# ------------------------------------------------------------------------------
JWT_SECRET=your_base64_encoded_256bit_secret_key_here

# ------------------------------------------------------------------------------
# ✨ Google Gemini Flash Vision API
# Lấy API Key cá nhân miễn phí tại Google AI Studio:
#   https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# ☁️ AWS S3 Storage (Tùy chọn - Chuyển AWS_S3_ENABLED=false để lưu trữ cục bộ)
# ------------------------------------------------------------------------------
AWS_S3_ENABLED=false
AWS_S3_BUCKET=calorie-tracker-meals
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Thư mục lưu trữ hình ảnh cục bộ khi AWS_S3_ENABLED=false
LOCAL_STORAGE_DIR=./uploads
